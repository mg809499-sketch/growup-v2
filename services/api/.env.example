# Entorno local de la API. Copiar a .env y completar.
GROWUP_ENVIRONMENT=local
GROWUP_DEBUG=true
# Login aislado de workers; en staging/prod no reutilizar la credencial de la API.
GROWUP_WORKER_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
GROWUP_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
GROWUP_REDIS_URL=redis://localhost:6379/0
GROWUP_SUPABASE_URL=https://<project-ref>.supabase.co
GROWUP_SUPABASE_JWT_AUDIENCE=authenticated
GROWUP_CORS_ORIGINS=http://localhost:3000
GROWUP_ROOT_DOMAIN=growup.com
GROWUP_INVENTORY_RESERVATION_TTL_SECONDS=900
# R2 (Cloudflare) para media de catálogo. Sin credenciales, los endpoints de media devuelven 503.
# Local con `docker compose -f infra/docker-compose.yml up -d`:
#   GROWUP_R2_ENDPOINT_URL=http://localhost:9000
#   GROWUP_R2_ACCESS_KEY_ID=growup
#   GROWUP_R2_SECRET_ACCESS_KEY=growup123
#   GROWUP_R2_PUBLIC_BASE_URL=http://localhost:9000/growup-catalog-local
GROWUP_R2_ENDPOINT_URL=
GROWUP_R2_ACCESS_KEY_ID=
GROWUP_R2_SECRET_ACCESS_KEY=
GROWUP_R2_CATALOG_BUCKET=growup-catalog-local
GROWUP_R2_PUBLIC_BASE_URL=
GROWUP_MEDIA_UPLOAD_URL_TTL_SECONDS=900
GROWUP_MEDIA_STALE_UPLOAD_SECONDS=3600
GROWUP_MAX_REQUEST_BYTES=1048576
# Secreto para firmar tokens de previsualización del builder. Cambiar en staging/prod.
GROWUP_PREVIEW_SECRET=dev-preview-secret-cambiar-en-produccion
# Clave maestra (Fernet) para secretos Wompi en reposo, base64 urlsafe 32 bytes.
# Generar: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GROWUP_PAYMENT_KEY=
# Wompi (checkout). Sandbox por defecto; en producción apuntar a production.wompi.co.
GROWUP_WOMPI_BASE_URL=https://checkout.wompi.co/p/
GROWUP_WOMPI_API_URL=https://sandbox.wompi.co/v1
# Purga de caché Next.js tras publicar (deploy hook de Vercel). Vacío = no-op local.
GROWUP_VERCEL_PURGE_URL=
# Observabilidad: sin DSN de Sentry no se inicializa.
GROWUP_SENTRY_DSN=
GROWUP_SENTRY_TRACES_SAMPLE_RATE=0.0
# Solo para tests de integración contra Supabase local.
GROWUP_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
