{
  "version": "v1",
  "hooks": [
    {
      "name": "api-quality",
      "trigger": "PostFileSave",
      "matcher": "services/api/.*\\.py$",
      "action": {
        "type": "command",
        "command": "cd services/api && uv run ruff check . && uv run mypy app"
      },
      "timeout": 120,
      "enabled": true
    }
  ]
}
