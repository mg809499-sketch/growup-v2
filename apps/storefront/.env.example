GROWUP_API_URL=http://localhost:8000
# Host que se envía a la API para resolver el tenant (debe existir en app.domains).
GROWUP_STOREFRONT_HOST=ropa.growup.com
GROWUP_DEFAULT_THEME=ropa
# Opcional si la API no devuelve URLs absolutas de media.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Origenes del admin permitidos como padre del iframe de /preview (CSP frame-ancestors).
# Separados por comas si hay más de uno (p. ej. :3001 ocupado por otra app y :3011 para este admin).
GROWUP_ADMIN_ORIGIN=http://localhost:3001
